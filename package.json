{
  "name": "crewd",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run --filter '@crewd/daemon' build",
    "daemon": "bun run --filter '@crewd/daemon' start",
    "tui": "bun run --filter '@crewd/tui' start",
    "typecheck": "tsc -p apps/daemon --noEmit && tsc -p apps/tui --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
