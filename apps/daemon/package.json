{
  "name": "@crewd/daemon",
  "private": true,
  "type": "module",
  "bin": {
    "crewd": "./dist/main.js"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --outdir dist --external @anthropic-ai/claude-agent-sdk --external @qoder-ai/qoder-agent-sdk",
    "start": "bun run build && node dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@crewd/protocol": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^22"
  }
}
